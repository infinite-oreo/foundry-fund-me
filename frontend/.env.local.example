# WalletConnect Project ID — 从 https://cloud.walletconnect.com 获取
# 纯 MetaMask 本地开发可填 placeholder
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# FundMe 合约地址 — 本地 Anvil
# 先执行: make deploy (项目根目录)，然后填入部署地址
NEXT_PUBLIC_ANVIL_CONTRACT_ADDRESS=0x

# FundMe 合约地址 — Sepolia 测试网
# 先执行: make deploy-sepolia，然后填入部署地址
NEXT_PUBLIC_SEPOLIA_CONTRACT_ADDRESS=0x
